# Salin file ini menjadi .env lalu isi.
# URL proyek, tanpa akhiran /rest/v1/
VITE_SUPABASE_URL=https://cjgtnmdksqctmdgijuef.supabase.co
# Key anon / publishable (BUKAN service_role / secret).
# Ambil dari dasbor Supabase: tombol Connect, atau Project Settings -> API Keys.
VITE_SUPABASE_ANON_KEY=
# Opsional, hanya untuk `npm run dev`: tujuan /api/* (API foto R2 dan pembayaran).
# Kosong = Worker situs yang sudah ter-deploy. Isi http://localhost:8787 bila memakai `npx wrangler dev`.
VITE_API_PROXY=
