{
  // Cloudflare Workers dengan static assets: menyajikan hasil build Vite di folder dist,
  // ditambah API foto di R2 (/api/r2/*, lihat worker/index.js) dan pembayaran Midtrans
  // (/api/pay/*, lihat worker/pay.js; rahasia MIDTRANS_* diatur di dasbor, bukan di file ini).
  // "name" harus sama dengan nama proyek Worker di dasbor Cloudflare.
  // Bucket R2 harus dibuat lebih dulu (README, bagian R2), kalau tidak deploy gagal.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "disposable-asiig",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-01",
  // Jangan hapus variabel yang diisi di dasbor Cloudflare saat deploy (wrangler biasanya menimpanya).
  // Kunci rahasia (MIDTRANS_*, SUPABASE_SERVICE_KEY, SIGN_SECRET) tetap sebaiknya bertipe Secret.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    // Alamat tak dikenal (tautan khusus acara, mis. /wisuda2026) menyajikan index.html
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "disposable-asiig-photos" }
  ]
}
